# Kernel configuration of the ruyi software-render profile.
#
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build. Fragments from the
# arch and OS profiles apply first, then this file.
#
# This file selects NO GPU driver. There is no "GPU off" switch to flip: the
# Adreno/AdrenoMetal components are simply absent from [components] in
# board.toml, so their archives are never built and nothing here could enable
# them. Software rendering is a property of this whole profile, not of a flag.
# Adding GPU support later means adding the components to board.toml.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y

# Platform expert from the board DTS (ArmDTPlatform) and the GICv3 + generic
# timer driver (ArmCpu).
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y

# XNU's AES routines without the Apple crypto accelerator.
CONFIG_XNU_NATIVE_AES=y

# Kernel entropy / trust cache handling for the iOS 16 userland.
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
# The kernel is prelinked against the original Apple kernelcache, so its crypto
# comes from there rather than from a freshly built module.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# Apple's BCM2837 PLATFORM_PANIC_LOG_PADDR (0x3C0FC000) is not DRAM on SM8650 and
# check_for_panic_log() faults on it. XNU_DT_PANIC_REGION takes the region from
# the device tree instead, and an absent node just returns, so PE_create_console
# reaches initialize_screen() and the kernel console maps onto the framebuffer
# DarwinBoot already set up.
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y

# Software display: publishes the MobileFramebuffer (IOMobileFramebuffer)
# service and copies composited IOSurface rows into the GOP scanout on the CPU.
# This is the display path for this profile; it has no GPU dependency.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

# Not applicable to this profile. Kept explicit so a later merge does not
# inherit them silently from another board's configuration.
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
# UFS root is a separate, unverified route. The software-render milestone boots
# the root filesystem from a RAM disk, so the UFS driver is not built.
CONFIG_XNU_NATIVE_UFS=n
