+ * unconditionally. As with sart.h, the protected page layer is not enabled on
+ * this non-Apple platform, so the bootstrap is a no-op.
+ */
+#ifndef _ARM64_PPL_UAT_H_
+#define _ARM64_PPL_UAT_H_
+
+static inline void
+uat_bootstrap(void)
+{
+}
+
+#endif /* _ARM64_PPL_UAT_H_ */
