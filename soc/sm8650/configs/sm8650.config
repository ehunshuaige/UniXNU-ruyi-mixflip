# Kernel configuration common to every SM8650 device in this repository.
# Applied after arch:configs/common.config and before the device defconfig.

CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y

# SM8650 is a GICv4 part: four frames per redistributor PE. The value travels in
# the device tree (redistributor-stride), not in the configuration; this comment
# is here so nobody "fixes" the DTS to the GICv3 default of 0x20000.
